{
    "name": "webkampus/sso-client",
    "description": "SSO OAuth2 Client Package for Laravel applications",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Web Kampus",
            "email": "dev@universitaspahlawan.ac.id"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "WebKampus\\SSOClient\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebKampus\\SSOClient\\SSOClientServiceProvider"
            ]
        }
    }
}
